# Data Vault Platform — environment template
# Copy to .env and adjust. No secrets are needed: the engine is a fully
# offline, in-process vault, so the platform runs with no credentials.
# Change DVP_HASH_SALT per environment: it namespaces every hash key.
DVP_HASH_SALT=data-vault-platform-v1
DVP_RECORD_SOURCE=synthetic-retail
DVP_RETENTION_DAYS=365
DVP_MAX_QUARANTINE_RATE=0.05
DVP_HOST=0.0.0.0
DVP_PORT=8000
